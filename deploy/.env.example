# Copy to .env.production, or use npm run deploy:init (never commit the real file).
PUBLIC_ORIGIN=https://perdtu.example.com
DATABASE_URL=postgresql://USER:URL_ENCODED_PASSWORD@PRIVATE_RDS_HOST:5432/perdtu?schema=public&sslmode=require&sslaccept=strict&sslcert=/run/perdtu-certs/rds-ca.pem
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# The same backend Dockerfile produces a temporary migrate image, not another API.
IMAGE_REGISTRY=perdtu
IMAGE_TAG=local
# HTTP is loopback-only by default. For public HTTPS add compose.https.yml.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTPS_BIND_ADDRESS=0.0.0.0
# Only needed with compose.postgres.yml; initializer generates a random value.
POSTGRES_PASSWORD=REPLACE_FOR_SELF_HOSTED_DB_ONLY
